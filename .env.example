# novel-it Environment Configuration
# Copy this file to .env and fill in your values.
# The .env file is never committed to version control.

# -----------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------

# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to True only during development — never in production
DJANGO_DEBUG=False

# Comma-separated list of hostnames Django will serve
# e.g. localhost,127.0.0.1,myserver.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to make cross-site requests
# Required for HTMX and form submissions when behind a reverse proxy
# e.g. http://localhost:8000,https://myserver.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# -----------------------------------------------------------------
# Database
# -----------------------------------------------------------------

# SQLite (default — no configuration needed, just leave DATABASE_URL unset)
# The database file will be created automatically at novelapp/db.sqlite3

# PostgreSQL (uncomment and fill in to use PostgreSQL instead)
# DATABASE_URL=postgresql://username:password@localhost:5432/novelapp
